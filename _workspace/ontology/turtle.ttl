    poke:hasMove poke:move-mega-punch, poke:move-pay-day, poke:move-fire-punch, poke:move-ice-punch .

# ----- 타입 효과 샘플 (불꽃·물) -----
poke:FireType a poke:Type ;
    rdfs:label "불꽃타입"@ko ;
    poke:strongAgainst poke:GrassType, poke:IceType, poke:BugType, poke:SteelType ;
    poke:weakAgainst poke:WaterType, poke:GroundType, poke:RockType .

poke:WaterType a poke:Type ;
    rdfs:label "물타입"@ko ;
    poke:strongAgainst poke:FireType, poke:GroundType, poke:RockType ;
    poke:weakAgainst poke:GrassType, poke:ElectricType .