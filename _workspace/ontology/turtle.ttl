    rdf:type poke:Pokemon, poke:LegendaryPokemon, poke:PsychicTypePokemon ;
    rdfs:label "뮤츠"@ko ;
    poke:dexNumber "150"^^xsd:integer ;
    poke:hasType poke:PsychicType ;
