    {
      "id": "ex-13-04",
      "type": "reasoning-sim",
      "title": "전이 + 분류 규칙 연쇄 적용",
      "prompt": "다음 데이터와 두 규칙이 있어요. 두 규칙을 순서대로 적용하면 어떤 트리플이 새로 도출될까요? (모두 고르세요)",
      "init": {
        "givenTriples": [
          ["poke:pokemon-172", "poke:evolvesTo", "poke:pokemon-25"],
          ["poke:pokemon-25", "poke:evolvesTo", "poke:pokemon-26"],
          ["poke:pokemon-25", "rdf:type", "poke:Pokemon"],
          ["poke:pokemon-25", "poke:hasType", "poke:ElectricType"]
        ],
        "rule": {
          "if": [
            ["?a", "poke:evolvesTo", "?b"],
            ["?b", "poke:evolvesTo", "?c"]
          ],
          "then": [["?a", "poke:evolvesToEventually", "?c"]]
        },
        "candidateAnswers": [
          ["poke:pokemon-172", "poke:evolvesToEventually", "poke:pokemon-26"],
          ["poke:pokemon-25", "rdf:type", "poke:ElectricTypePokemon"],
          ["poke:pokemon-26", "poke:evolvesToEventually", "poke:pokemon-172"],
          ["poke:pokemon-26", "poke:evolvesTo", "poke:pokemon-25"]
        ]
      },
      "validation": {
        "kind": "select-correct",
        "expected": [0],
        "partialCredit": false
      },
      "hints": [
        "보여준 규칙은 '전이 규칙'(evolvesTo의 연쇄)이에요.",
        "?a=피츄, ?b=피카츄, ?c=라이츄로 바인딩.",
        "결과는 '피츄 evolvesToEventually 라이츄' 한 줄."
      ],
      "successMessage": "맞아요! 전이 규칙으로 피츄가 결국 라이츄까지 도달함을 자동 추론.",
      "relatedConcepts": ["reasoning", "transitive-property", "inference-rule"]
    },
    {
      "id": "ex-13-05",
      "type": "query-build",
      "title": "추론 결과까지 포함한 SPARQL 쿼리",
      "prompt": "추론 엔진이 evolvesFrom을 채워준 뒤, '이브이로부터 진화한 모든 포켓몬'을 찾는 쿼리를 만드세요.",
      "init": {
        "queryShape": "SELECT ?evolution WHERE { ?evolution ?prop ?subj }",
        "options": {
          "?prop": ["poke:evolvesFrom", "poke:evolvesTo", "poke:hasType"],
          "?subj": ["poke:pokemon-133", "poke:pokemon-25", "poke:pokemon-172"]
        }
      },
      "validation": {
        "kind": "query-match",
        "expected": { "?prop": "poke:evolvesFrom", "?subj": "poke:pokemon-133" },
        "partialCredit": false
      },
      "hints": [
        "'이브이로부터 진화한' = '진화 전이 이브이'.",
        "evolvesFrom 속성과 이브이(pokemon-133) 사용.",
        "?prop=poke:evolvesFrom, ?subj=poke:pokemon-133."
      ],
      "successMessage": "정답! 명시 데이터에는 evolvesFrom이 없었는데, 추론으로 채워져서 8형제가 결과로 나와요.",
      "relatedConcepts": ["reasoning", "asserted-vs-inferred", "sparql"]
    }
  ]
}
