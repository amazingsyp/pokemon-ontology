    {
      "id": "ex-12-04",
      "type": "reasoning-sim",
      "title": "OWL 제약이 만드는 자동 분류",
      "prompt": "다음 트리플과 OWL 정의가 있을 때 자동으로 도출되는 분류 트리플은?",
      "init": {
        "givenTriples": [
          ["poke:pokemon-150", "rdf:type", "poke:Pokemon"],
          ["poke:pokemon-150", "poke:isLegendary", "\"true\"^^xsd:boolean"]
        ],
        "rule": {
          "if": [["?p", "rdf:type", "poke:Pokemon"], ["?p", "poke:isLegendary", "\"true\"^^xsd:boolean"]],
          "then": [["?p", "rdf:type", "poke:LegendaryPokemon"]]
        },
        "candidateAnswers": [
          ["poke:pokemon-150", "rdf:type", "poke:LegendaryPokemon"],
          ["poke:pokemon-150", "rdf:type", "poke:MythicalPokemon"],
          ["poke:LegendaryPokemon", "rdf:type", "poke:pokemon-150"],
          ["poke:pokemon-150", "poke:isLegendary", "false"]
        ]
      },
      "validation": {
        "kind": "select-correct",
        "expected": [0],
        "partialCredit": false
      },
      "hints": [
        "?p에 무엇이 바인딩되는지 보세요.",
        "?p = pokemon-150 (뮤츠), 그래서 뮤츠가 LegendaryPokemon으로 분류돼요.",
        "결과는 '뮤츠 rdf:type LegendaryPokemon'."
      ],
      "successMessage": "정답! OWL 정의 한 줄로 멤버가 자동 분류돼요 — 이게 다음 챕터(추론)의 핵심이에요.",
      "relatedConcepts": ["owl", "class-restriction", "equivalent-class"]
    }
